{
  "name": "ai-hay-day-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:webapp": "npm run build && node scripts/copy-dist-to-webapp.js",
    "dev:api": "node scripts/mock-server/server.js",
    "apps:list-deployments": "node scripts/apps-script/list-deployments.mjs",
    "apps:deploy": "npm run build:webapp && npx clasp push --rootDir scripts/apps-script/webapp && node scripts/apps-script/create-or-update-deployment.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "express": "^4.18.2",
    "googleapis": "^128.0.0"
  }
}
